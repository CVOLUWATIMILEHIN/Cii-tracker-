{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe CII workspace profile and RBAC role assignment (PII isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "programme_manager", "reviewer", "partner", "member", "editor", "user"], "maxLength": 24 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "pending"], "maxLength": 16 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "cohortName": { "type": "string", "maxLength": 100 },
        "assignedCohortIds": { "type": "array" },
        "partnerId": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 100 },
        "stateCode": { "type": "string", "maxLength": 32 },
        "ppa": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "minLength": 1, "maxLength": 64 },
        "inviteCode": { "type": "string", "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 32 },
        "gender": { "type": "string", "maxLength": 24 },
        "state": { "type": "string", "maxLength": 48 },
        "organisation": { "type": "string", "maxLength": 120 },
        "maxCaseload": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "displayName", "role", "status", "cohortId", "cohortName",
        "assignedCohortIds", "partnerId", "partnerName", "stateCode", "ppa",
        "department", "inviteCode", "lastLoginAt", "createdAt", "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated user PII (email, phone) accessible only to owner and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "phone", "lastActiveAt", "updatedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Administrator-issued account activation invitation for CII participants and partners.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "programme_manager", "reviewer", "partner", "member"], "maxLength": 24 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "cohortName": { "type": "string", "maxLength": 100 },
        "assignedCohortIds": { "type": "array" },
        "partnerId": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 100 },
        "stateCode": { "type": "string", "maxLength": 32 },
        "ppa": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "gender": { "type": "string", "maxLength": 24 },
        "state": { "type": "string", "maxLength": 48 },
        "organisation": { "type": "string", "maxLength": 120 },
        "maxCaseload": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "claimed", "revoked"], "maxLength": 16 },
        "claimedBy": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "email", "displayName", "role", "cohortId", "cohortName",
        "assignedCohortIds", "partnerId", "partnerName", "stateCode", "ppa",
        "department", "status", "claimedBy", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "Cohort": {
      "title": "Cohort",
      "description": "CII programme cohort or service batch.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "code": { "type": "string", "pattern": "^[A-Z0-9\\-]+$", "minLength": 2, "maxLength": 24 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "startDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 16 },
        "endDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 16 },
        "status": { "type": "string", "enum": ["active", "archived"], "maxLength": 16 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "description", "startDate", "endDate", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Assigned CII programme activity or responsibility.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "code": { "type": "string", "pattern": "^[A-Z0-9\\-]+$", "minLength": 3, "maxLength": 24 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 1000 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "pillar": { "type": "string", "enum": ["Governance", "Infrastructure", "Sustainability", "Community", "Security"], "maxLength": 32 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "cohortName": { "type": "string", "maxLength": 100 },
        "assignmentScope": { "type": "string", "enum": ["all", "cohort", "selected"], "maxLength": 16 },
        "assignedMemberIds": { "type": "array" },
        "deadline": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 16 },
        "evidenceRequired": { "type": "boolean" },
        "reviewRequired": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"], "maxLength": 16 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "code", "title", "description", "instructions", "pillar",
        "cohortId", "cohortName", "assignmentScope", "assignedMemberIds",
        "deadline", "evidenceRequired", "reviewRequired", "status",
        "createdBy", "createdByName", "createdAt", "updatedAt"
      ]
    },
    "ActivitySubmission": {
      "title": "ActivitySubmission",
      "description": "Corps Member submission, evidence upload metadata, and review feedback for an activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "activityId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "activityTitle": { "type": "string", "minLength": 1, "maxLength": 140 },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "progress": { "type": "number" },
        "responseText": { "type": "string", "maxLength": 2000 },
        "evidenceUrl": { "type": "string", "maxLength": 500 },
        "evidenceName": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["in_progress", "submitted", "under_review", "revision_requested", "approved"], "maxLength": 24 },
        "feedbackText": { "type": "string", "maxLength": 1000 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "activityId", "activityTitle", "memberId", "memberName",
        "cohortId", "partnerId", "progress", "responseText", "evidenceUrl", "evidenceName",
        "status", "feedbackText", "reviewedBy", "reviewedByName", "createdAt", "updatedAt"
      ]
    },
    "DailyCheckin": {
      "title": "DailyCheckin",
      "description": "Daily status check-in (deterministic ID memberId_YYYY-MM-DD prevents duplicate submissions).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "checkinDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 16 },
        "status": { "type": "string", "enum": ["on_track", "need_support", "blocked"], "maxLength": 24 },
        "updateText": { "type": "string", "maxLength": 600 },
        "followUpRequested": { "type": "boolean" },
        "flaggedForAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "memberId", "memberName", "cohortId", "partnerId",
        "checkinDate", "status", "updateText", "followUpRequested", "flaggedForAdmin",
        "createdAt", "updatedAt"
      ]
    },
    "WeeklyReport": {
      "title": "WeeklyReport",
      "description": "Weekly accountability report covering achievements, challenges, learnings, and next-week priorities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "weekKey": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$", "maxLength": 16 },
        "weekLabel": { "type": "string", "minLength": 3, "maxLength": 64 },
        "achievements": { "type": "string", "maxLength": 1500 },
        "challenges": { "type": "string", "maxLength": 1500 },
        "learnings": { "type": "string", "maxLength": 1500 },
        "nextWeekPriorities": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["draft", "submitted", "under_review", "revision_requested", "reviewed"], "maxLength": 24 },
        "feedbackText": { "type": "string", "maxLength": 1000 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "memberId", "memberName", "cohortId", "partnerId",
        "weekKey", "weekLabel", "achievements", "challenges", "learnings", "nextWeekPriorities",
        "status", "feedbackText", "reviewedBy", "reviewedByName", "createdAt", "updatedAt"
      ]
    },
    "FollowUp": {
      "title": "FollowUp",
      "description": "Accountability Partner follow-up record for assigned Corps Members.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "partnerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "partnerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceType": { "type": "string", "enum": ["checkin", "report", "manual"], "maxLength": 16 },
        "sourceId": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "minLength": 1, "maxLength": 800 },
        "actionTaken": { "type": "string", "maxLength": 800 },
        "status": { "type": "string", "enum": ["open", "resolved"], "maxLength": 16 },
        "flaggedForAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "partnerId", "partnerName", "memberId", "memberName",
        "sourceType", "sourceId", "note", "actionTaken", "status",
        "flaggedForAdmin", "createdAt", "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Programme-wide or cohort-targeted administrator announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "body": { "type": "string", "minLength": 3, "maxLength": 1500 },
        "targetRole": { "type": "string", "enum": ["all", "member", "partner"], "maxLength": 16 },
        "cohortId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["normal", "important"], "maxLength": 16 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "targetRole", "cohortId", "priority", "createdBy", "createdByName", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications linked to activities, check-ins, reports, feedback, and announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "recipientId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "type": { "type": "string", "enum": ["activation", "activity", "deadline", "checkin", "report", "feedback", "revision", "announcement", "partner"], "maxLength": 24 },
        "linkPath": { "type": "string", "maxLength": 140 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "title", "message", "type", "linkPath", "read", "createdAt"]
    },
    "ProgrammeSettings": {
      "title": "ProgrammeSettings",
      "description": "Configurable CII governance settings such as formal report approval policy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "partnerCanApproveReports": { "type": "boolean" },
        "weeklyReportDueDay": { "type": "string", "maxLength": 24 },
        "inactivityThresholdDays": { "type": "number" },
        "emailProviderNote": { "type": "string", "maxLength": 300 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "partnerCanApproveReports", "weeklyReportDueDay", "inactivityThresholdDays", "emailProviderNote", "updatedBy", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable append-only system activity audit logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "actorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "actorRole": { "type": "string", "enum": ["super_admin", "admin", "programme_manager", "reviewer", "partner", "member", "editor", "user"], "maxLength": 24 },
        "action": { "type": "string", "minLength": 2, "maxLength": 64 },
        "category": { "type": "string", "enum": ["auth", "activity", "checkin", "report", "rbac", "cohort", "announcement", "export", "settings"], "maxLength": 24 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"], "maxLength": 16 },
        "targetType": { "type": "string", "maxLength": 32 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 3, "maxLength": 280 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorId", "actorName", "actorRole", "action", "category", "severity", "targetType", "targetId", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe user profile and role metadata."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection."
    },
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Admin-issued account activation invitations."
    },
    "/cohorts/{cohortId}": {
      "schema": { "$ref": "#/entities/Cohort" },
      "description": "CII cohorts and groups."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Programme activities and deliverables."
    },
    "/activity_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ActivitySubmission" },
      "description": "Member activity responses, evidence, and feedback."
    },
    "/daily_checkins/{checkinId}": {
      "schema": { "$ref": "#/entities/DailyCheckin" },
      "description": "Daily accountability check-ins."
    },
    "/weekly_reports/{reportId}": {
      "schema": { "$ref": "#/entities/WeeklyReport" },
      "description": "Weekly accountability reports."
    },
    "/follow_ups/{followUpId}": {
      "schema": { "$ref": "#/entities/FollowUp" },
      "description": "Partner follow-up records and admin escalations."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Programme announcements."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/ProgrammeSettings" },
      "description": "Configurable governance and review policy settings."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only system audit logs."
    }
  }
}
